# Backend Environment Variables
NODE_ENV=development
PORT=3001

# Netatmo OAuth Credentials (from https://dev.netatmo.com)
NETATMO_CLIENT_ID=your_client_id_here
NETATMO_CLIENT_SECRET=your_client_secret_here
NETATMO_REDIRECT_URI=http://localhost:3001/auth/callback
FRONTEND_ORIGIN=http://localhost:5173

# Session secret for secure cookies
SESSION_SECRET=change-this-to-a-random-secure-string

# API Caching (in minutes)
CACHE_TTL_MINUTES=5
